        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Colima tourne sans Rosetta : l'image x86_64 y est émulée trop lentement et le moteur du wrapper expire. L'assistant peut redémarrer Colima avec Rosetta (%1$lld cœurs, %2$lld Go)."
          }
